APP_NAME=FastAPI Blog API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://blog:blog@localhost:5432/blog
# Optional pooled endpoint for application traffic (Neon). Keep DATABASE_URL
# pointed at the direct endpoint for Alembic migrations.
DATABASE_URL_POOLED=
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT=120/minute
DISCORD_WEBHOOK_URL=replace-with-your-discord-webhook-url
DISCORD_UID=replace-with-your-discord-user-id
